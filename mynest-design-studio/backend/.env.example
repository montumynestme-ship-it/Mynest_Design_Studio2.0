# ─────────────────────────────────────────────────────────────
# MyNest Design Studio — Backend environment (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values locally:
#   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real secrets or API keys.
# All secrets and AI provider keys live ONLY on the backend, never
# in the frontend (which ships to the browser).
#
# NOTE: Most values below are PLANNED. The backend does not read them
# yet — they document where configuration will go as features land.
# ─────────────────────────────────────────────────────────────

# ── Application ──
# ENVIRONMENT=development        # development | staging | production
# DEBUG=true

# ── CORS ──
# Comma-separated list of browser origins allowed to call the API.
# (Dev origins are currently set directly in app/main.py; this will
# move here once configuration is wired up.)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (PostgreSQL) ──
# Set this to enable the Postgres data layer. Use the psycopg driver prefix.
# When empty, the app falls back to local JSON storage.
#   Local:    DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/mynest
#   Supabase: DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
# (If your link starts with just postgresql://, add "+psycopg" after it.)
# DATABASE_URL=

# ── Cache / task broker (planned) ──
# REDIS_URL=redis://localhost:6379/0

# ── Object storage (planned) ──
# S3-compatible bucket for floor-plan uploads, assets, and exports.
# STORAGE_ENDPOINT_URL=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# ── Security (planned) ──
# Secret used to sign tokens/sessions. Generate a long random value.
# SECRET_KEY=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# ── AI image provider — NVIDIA-hosted FLUX (the ONLY provider) ──
# SERVER-SIDE ONLY. The key is read here and NEVER exposed to the frontend,
# logged, or returned in a response. Auth is `Authorization: Bearer <key>`.
# On a failure the app surfaces a real error — it NEVER falls back to
# pollinations, BFL, Gemini, or the Three.js base as a "successful" AI result.
# ─────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your-nvidia-api-key
# NVIDIA hosted image model. Default flux.1-dev is TEXT-TO-IMAGE.
# NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# NVIDIA_API_BASE=https://ai.api.nvidia.com/v1/genai
# Image-to-image (geometry lock). When true, the deterministic base render is
# UPLOADED as an NVCF asset (POST https://api.nvcf.nvidia.com/v2/nvcf/assets ->
# presigned PUT) and referenced in the request as `data:image/png;example_id,<id>`
# with the header `NVCF-INPUT-ASSET-REFERENCES: <id>`. Inline base64 is REJECTED
# by the hosted API (HTTP 422). This is the verified contract.
# NVIDIA_SUPPORTS_IMG2IMG=false
# Control mode when img2img is on:
#   canny   — ControlNet on Canny edges (strongest geometry lock). flux.1-dev.
#   depth   — ControlNet on a depth map. flux.1-dev.
#   kontext — image-edit; set NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-kontext-dev.
# NVIDIA_IMG2IMG_MODE=canny
# NOTE (verified 2026-09-15): on the current account, canny/depth/kontext image
# generation returns HTTP 500 at inference time even though the request schema is
# accepted — the hosted image-conditioned models appear not to be entitled/served
# for this key. Text-to-image (base) works. Confirm image-model access with NVIDIA
# before relying on img2img; the adapter is already wired to the correct contract.
#
# Provider selection + timeout.
# DEFAULT_AI_PROVIDER=nvidia
# AI_TIMEOUT_SECONDS=60
# AI_DEMO_MODE=false            # true = deterministic placeholder renderer (offline/dev)
# Seconds between sequential room generations, to avoid provider per-minute 429s.
# AI_ROOM_DELAY_SECONDS=4
