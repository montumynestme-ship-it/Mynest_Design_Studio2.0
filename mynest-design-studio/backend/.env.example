# ─────────────────────────────────────────────────────────────
# MyNest Design Studio — Backend environment (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values locally:
#   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real secrets or API keys.
# All secrets and AI provider keys live ONLY on the backend, never
# in the frontend (which ships to the browser).
#
# NOTE: Most values below are PLANNED. The backend does not read them
# yet — they document where configuration will go as features land.
# ─────────────────────────────────────────────────────────────

# ── Application ──
# ENVIRONMENT=development        # development | staging | production
# DEBUG=true

# ── CORS ──
# Comma-separated list of browser origins allowed to call the API.
# (Dev origins are currently set directly in app/main.py; this will
# move here once configuration is wired up.)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database (PostgreSQL) ──
# Set this to enable the Postgres data layer. Use the psycopg driver prefix.
# When empty, the app falls back to local JSON storage.
#   Local:    DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/mynest
#   Supabase: DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
# (If your link starts with just postgresql://, add "+psycopg" after it.)
# DATABASE_URL=

# ── Cache / task broker (planned) ──
# REDIS_URL=redis://localhost:6379/0

# ── Object storage (planned) ──
# S3-compatible bucket for floor-plan uploads, assets, and exports.
# STORAGE_ENDPOINT_URL=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# ── Security (planned) ──
# Secret used to sign tokens/sessions. Generate a long random value.
# SECRET_KEY=change-me-to-a-long-random-string

# ─────────────────────────────────────────────────────────────
# ── AI providers (PLANNED — NOT implemented yet) ──
# When AI visualization is added, provider API keys go here.
# These are SERVER-SIDE ONLY and must never be exposed to the frontend.
# Leave blank / commented until each provider is actually wired up.
# ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
